# ==========================================================
# SnapLink Frontend Environment Configuration
# Copy this file to ".env" and replace the values.
#
# EVERY VARIABLE HERE IS BAKED IN AT BUILD TIME. Changing one in Vercel means
# redeploying, not restarting — and a build picks up whatever is in the shell
# or in a local .env file, so a production build run on a developer machine
# will silently inherit the localhost values below.
#
# VITE_API_URL and VITE_APP_URL are REQUIRED. If either is missing the build
# still succeeds and the deployed site renders a blank white page, because the
# check that throws runs before React mounts. See DEPLOYMENT.md.
# ==========================================================

# ----------------------------------------------------------
# Backend API origin. The client appends /api/v1 itself, so no path here.
#
# PRODUCTION: VITE_API_URL=https://api.your-domain.com   (no trailing slash)
# ----------------------------------------------------------
VITE_API_URL=http://localhost:5000

# ----------------------------------------------------------
# Public origin that short links resolve from. Used to display and build short
# URLs, and it is where the password-gate unlock request is POSTed.
#
# This is the BACKEND's public origin, not the frontend's — short links are
# served by the backend at its root. Unless you have put short links on a
# separate domain pointing at the same backend, it is the same value as
# VITE_API_URL, and it must match the backend's own APP_URL.
#
# PRODUCTION: VITE_APP_URL=https://api.your-domain.com
# ----------------------------------------------------------
VITE_APP_URL=http://localhost:5000

# ----------------------------------------------------------
# Google OAuth client id. Must belong to the same Google project as the
# backend's GOOGLE_CLIENT_ID, or token verification fails.
# Optional: left empty, no Google button or divider is rendered.
# ----------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=

# ----------------------------------------------------------
# Public origin of the deployed FRONTEND. Build-time only: it is what
# robots.txt and sitemap.xml are generated from. Without it the sitemap is not
# emitted at all, because a sitemap needs absolute URLs.
#
# PRODUCTION: VITE_SITE_URL=https://your-app.vercel.app
# ----------------------------------------------------------
VITE_SITE_URL=

# ----------------------------------------------------------
# Support channels shown on /contact. Both optional — a channel that is not set
# is simply not rendered, rather than advertising an address nobody reads. With
# neither set, /contact shows a "no contact channel listed" notice.
# ----------------------------------------------------------
VITE_SUPPORT_EMAIL=
VITE_REPO_URL=
