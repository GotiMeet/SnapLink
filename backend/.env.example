# ==========================================================
# SnapLink Environment Configuration
# Copy this file to ".env" and replace the placeholder values.
# Never commit your actual ".env" file.
# ==========================================================

# ----------------------------------------------------------
# Server
# ----------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ----------------------------------------------------------
# Public Base URL
# The origin short links resolve from, used to build QR codes.
# Production example: https://snaplink.com
# ----------------------------------------------------------
APP_URL=http://localhost:5000

# ----------------------------------------------------------
# Database (MongoDB Atlas)
# Replace <username>, <password>, and <cluster-url>
# ----------------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/snaplink?retryWrites=true&w=majority&appName=SnapLink

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------
CORS_ORIGIN=http://localhost:3000

# ----------------------------------------------------------
# Password Hashing
# ----------------------------------------------------------
BCRYPT_SALT_ROUNDS=12

# ----------------------------------------------------------
# JWT Secrets
# Replace all placeholder values with strong random secrets.
# ----------------------------------------------------------
JWT_ACCESS_SECRET=your-access-token-secret
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_EMAIL_VERIFICATION_SECRET=your-email-verification-secret
JWT_PASSWORD_RESET_SECRET=your-password-reset-secret

# ----------------------------------------------------------
# JWT Expiration Times (in seconds)
# ----------------------------------------------------------
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_EMAIL_VERIFICATION_TTL=86400
JWT_PASSWORD_RESET_TTL=900

# ----------------------------------------------------------
# Cookie Configuration
# ----------------------------------------------------------
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=

# ----------------------------------------------------------
# Google OAuth
# ----------------------------------------------------------
GOOGLE_CLIENT_ID=

# ----------------------------------------------------------
# Email / SMTP
# ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SnapLink <no-reply@snaplink.local>