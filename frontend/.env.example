# Backend API origin. The client appends /api/v1 itself.
VITE_API_URL=http://localhost:5000

# Public origin that short links resolve from. Used to display and build short URLs,
# and it is where the password-gate unlock request is POSTed.
VITE_APP_URL=http://localhost:5000

# Google OAuth client id. Must belong to the same Google project as the backend's
# GOOGLE_CLIENT_ID or token verification fails.
VITE_GOOGLE_CLIENT_ID=

# Public origin of the deployed frontend. Build-time only: it is what robots.txt
# and sitemap.xml are generated from. Without it the sitemap is not emitted,
# because a sitemap needs absolute URLs.
VITE_SITE_URL=

# Support channels shown on /contact. Both optional — a channel that is not set
# is simply not rendered, rather than advertising an address nobody reads.
VITE_SUPPORT_EMAIL=
VITE_REPO_URL=
