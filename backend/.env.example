# ==========================================================
# SnapLink Environment Configuration
# Copy this file to ".env" and replace the placeholder values.
# Never commit your actual ".env" file.
#
# The values below are the LOCAL DEVELOPMENT defaults. Every line that differs
# in production is marked "PRODUCTION:". See DEPLOYMENT.md for the full list.
# ==========================================================

# ----------------------------------------------------------
# Server
#
# CLIENT_URL is the origin the frontend is served from. It is not only CORS:
# it is the base for the /unlock/:shortCode and /link-unavailable redirects the
# redirect controller issues, and for the verify-email and reset-password links
# in outgoing email. Get it wrong and those all point at the wrong host.
#
# PRODUCTION: NODE_ENV=production
# PRODUCTION: CLIENT_URL=https://your-app.vercel.app   (no trailing slash)
# ----------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ----------------------------------------------------------
# Public Base URL
#
# The origin short links resolve from, and therefore what every QR code
# encodes. This is the backend's own public origin, because the redirect
# routes are served by this application at its root.
#
# Required in production: the server refuses to start without it.
# PRODUCTION: APP_URL=https://api.your-domain.com
# ----------------------------------------------------------
APP_URL=http://localhost:5000

# ----------------------------------------------------------
# Database (MongoDB Atlas)
# Replace <username>, <password>, and <cluster-url>
#
# MUST be a replica set. createUrl, restoreUrl and the project lifecycle run
# inside transactions, which MongoDB only supports on a replica set. Atlas is
# a replica set on every tier including the free one; a self-hosted standalone
# mongod is not, and link creation fails outright on one.
# ----------------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/snaplink?retryWrites=true&w=majority&appName=SnapLink

# ----------------------------------------------------------
# CORS
#
# ONE origin only. This value is handed to the cors package as a single string,
# so a comma-separated list is echoed back verbatim as an invalid
# Access-Control-Allow-Origin header and the browser blocks the request. If you
# need apex plus www, redirect one to the other at the edge instead.
#
# Leaving this UNSET is safe: it falls back to CLIENT_URL. Setting it to a
# stale value is not — a wrong value wins over a correct CLIENT_URL silently.
#
# PRODUCTION: omit entirely, or set to exactly the same origin as CLIENT_URL.
# ----------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------------------
# Password Hashing
# ----------------------------------------------------------
BCRYPT_SALT_ROUNDS=12

# ----------------------------------------------------------
# JWT Secrets
# Replace all placeholder values with strong random secrets.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ----------------------------------------------------------
JWT_ACCESS_SECRET=your-access-token-secret
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_EMAIL_VERIFICATION_SECRET=your-email-verification-secret
JWT_PASSWORD_RESET_SECRET=your-password-reset-secret

# ----------------------------------------------------------
# JWT Expiration Times (in seconds)
#
# JWT_EMAIL_VERIFICATION_TTL must stay at 900. The interface tells the user in
# four places that a verification link expires in 15 minutes; any other value
# makes the product lie about its own token lifetime.
# ----------------------------------------------------------
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_EMAIL_VERIFICATION_TTL=900
JWT_PASSWORD_RESET_TTL=900

# ----------------------------------------------------------
# Cookie Configuration
#
# LEAVE THESE COMMENTED OUT. When unset, the server derives the correct flags
# from NODE_ENV: Secure + SameSite=None in production, and SameSite=Lax in
# development where the frontend and API share localhost.
#
# Setting them explicitly is how cross-site authentication breaks silently. On
# a Vercel frontend talking to a separately hosted API, SameSite=Lax means the
# browser never attaches the auth cookies: sign-in appears to succeed and the
# user is bounced straight back to the login page, with no error anywhere.
#
# The two are coupled — SameSite=None without Secure is rejected outright by
# every current browser.
#
# COOKIE_DOMAIN is only for sharing cookies across subdomains of one domain.
# Set to anything the API is not served from, the browser discards the cookie.
#
# PRODUCTION: leave all three unset.
# ----------------------------------------------------------
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# COOKIE_DOMAIN=

# ----------------------------------------------------------
# Google OAuth
#
# Must be the same client id as the frontend's VITE_GOOGLE_CLIENT_ID, from the
# same Google project, or POST /auth/google rejects every token it is handed.
# Only the client id is used: the backend verifies Google ID tokens, which
# needs no client secret.
# ----------------------------------------------------------
GOOGLE_CLIENT_ID=

# ----------------------------------------------------------
# Email / SMTP
# Required in production: the server refuses to start without host, user and pass.
# ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SnapLink <no-reply@snaplink.local>
